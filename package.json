{
  "name": "@piperland/async",
  "version": "0.1.0-beta.0",
  "description": "Async control for JavaScript and TypeScript.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "async",
    "concurrency",
    "structured-concurrency",
    "abortsignal",
    "retry",
    "timeout"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piperland/async.git"
  },
  "homepage": "https://github.com/piperland/async",
  "bugs": {
    "url": "https://github.com/piperland/async/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "bench": "node bench/map.bench.mjs && node bench/retry.bench.mjs && node bench/timeout.bench.mjs && node bench/race.bench.mjs && node bench/scope.bench.mjs",
    "bench:map": "node bench/map.bench.mjs",
    "bench:retry": "node bench/retry.bench.mjs",
    "bench:timeout": "node bench/timeout.bench.mjs",
    "bench:race": "node bench/race.bench.mjs",
    "bench:scope": "node bench/scope.bench.mjs",
    "test:browser": "node test/browser/run-browser-test.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test:workers": "vitest run --config test/workers/vitest.workers.config.mts",
    "release:check": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test && corepack pnpm build && corepack pnpm pack --dry-run && node scripts/release-guard.mjs --no-registry"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@types/node": "26.2.0",
    "expect-type": "^1.4.0",
    "p-limit": "7.3.1",
    "p-map": "7.0.6",
    "p-retry": "8.0.0",
    "p-timeout": "7.0.1",
    "playwright": "1.62.1",
    "tinybench": "^6.1.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
